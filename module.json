{
  "id": "taxes",
  "name": "Taxes",
  "version": "2.3.8",
  "description": "Fiscal categories and per-jurisdiction tax rules, plus the engine that resolves the rate at sale time.",
  "agent": {
    "description": "Manages fiscal categories (the linkable tax_category_key), per-jurisdiction tax rules (the % by country+region+category, with multi-tax components like surcharge), and category aliases for CSV import. Resolves the applicable tax for a sale line by category.",
    "keywords": [
      "tax",
      "vat",
      "category",
      "rule",
      "fiscal",
      "calculation",
      "alias",
      "surcharge"
    ]
  },
  "depends_on": [],
  "permissions": [
    "taxes.view_tax",
    "taxes.manage_tax",
    "taxes.calculate_tax"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "cashier": [
      "taxes.view_tax",
      "taxes.calculate_tax"
    ],
    "manager": [
      "taxes.view_tax",
      "taxes.manage_tax",
      "taxes.calculate_tax"
    ],
    "employee": [
      "taxes.view_tax",
      "taxes.calculate_tax"
    ]
  },
  "navigation": [
    {
      "id": "categories",
      "label": "Categories",
      "icon": "pricetags",
      "component": "erp-taxes-categories"
    },
    {
      "id": "rules",
      "label": "Tax Rules",
      "icon": "receipt-outline",
      "component": "erp-taxes-rules"
    },
    {
      "id": "aliases",
      "label": "Aliases",
      "icon": "swap-horizontal-outline",
      "component": "erp-taxes-aliases"
    }
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_fiscal_qualification.sql",
      "migrations/postgres/003_backfill_es_vat_baseline.sql",
      "migrations/postgres/004_taxes_rule_natural_key.sql",
      "migrations/postgres/005_category_labels.sql"
    ]
  },
  "seed": {
    "postgres": [
      "seed/install.postgres.sql"
    ]
  },
  "queries": {
    "taxes.categories.list": {
      "permission": "taxes.view_tax",
      "sql": "queries/categories_list.sql",
      "list": {
        "search": [
          "key",
          "name",
          "description",
          "display_name"
        ],
        "sort": [
          "id",
          "key",
          "name",
          "is_system",
          "is_active",
          "display_name"
        ],
        "default_sort": "key",
        "default_dir": "asc",
        "filters": {
          "key": {
            "op": "eq"
          },
          "name": {
            "op": "like"
          },
          "is_system": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          },
          "display_name": {
            "op": "like"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the canonical fiscal categories (the linkable tax_category_key)"
      },
      "expose_api": true
    },
    "taxes.categories.get": {
      "permission": "taxes.view_tax",
      "sql": "queries/category_get.sql",
      "ai": {
        "description": "Gets a fiscal category by its canonical key (FK validation for import)"
      },
      "expose_api": true
    },
    "taxes.rules.list": {
      "permission": "taxes.view_tax",
      "sql": "queries/rules_list.sql",
      "list": {
        "search": [
          "country_code",
          "region_code",
          "tax_category_key",
          "operation_class"
        ],
        "sort": [
          "id",
          "country_code",
          "region_code",
          "tax_category_key",
          "rate_pct",
          "tax_type",
          "valid_from",
          "valid_to",
          "is_active",
          "operation_class",
          "regime_key"
        ],
        "default_sort": "tax_category_key",
        "default_dir": "asc",
        "filters": {
          "country_code": {
            "op": "eq"
          },
          "region_code": {
            "op": "eq"
          },
          "tax_category_key": {
            "op": "eq"
          },
          "rate_pct": {
            "op": "range"
          },
          "tax_type": {
            "op": "eq"
          },
          "parent_id": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          },
          "operation_class": {
            "op": "eq"
          },
          "regime_key": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all tax rules (rate + fiscal qualification by country+region+category, including multi-tax components). The qualification says whether the operation is subject, exempt or not subject, under which regime, and — when exempt — the exemption cause."
      },
      "expose_api": true
    },
    "taxes.rules.by_country": {
      "permission": "taxes.view_tax",
      "sql": "queries/rules_by_country.sql",
      "ai": {
        "description": "Lists tax rules for a given country"
      },
      "expose_api": true
    },
    "taxes.aliases.list": {
      "permission": "taxes.view_tax",
      "sql": "queries/aliases_list.sql",
      "list": {
        "search": [
          "alias",
          "tax_category_key"
        ],
        "sort": [
          "id",
          "alias",
          "tax_category_key",
          "source",
          "is_active"
        ],
        "default_sort": "alias",
        "default_dir": "asc",
        "filters": {
          "alias": {
            "op": "like"
          },
          "tax_category_key": {
            "op": "eq"
          },
          "source": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists category aliases (external text → canonical key) used by CSV import"
      },
      "expose_api": true
    },
    "taxes.aliases.resolve": {
      "permission": "taxes.view_tax",
      "sql": "queries/alias_resolve.sql",
      "ai": {
        "description": "Resolves an external alias text to a canonical tax_category_key"
      },
      "expose_api": true
    },
    "taxes.rules.status": {
      "permission": "taxes.view_tax",
      "sql": "queries/setup_status.sql",
      "ai": {
        "description": "Configuration state of the tax module: how many active, currently valid root tax rules match the hub's fiscal country. Zero means the sale engine cannot resolve a rate for what this hub sells, so the till would fall back to a guessed one."
      }
    }
  },
  "commands": {
    "taxes.categories.create": {
      "permission": "taxes.manage_tax",
      "transaction": true,
      "sql": [
        "commands/category_create.sql"
      ],
      "schema": "schemas/category_create.json",
      "emit": [
        "taxes.category.created"
      ],
      "ai": {
        "description": "Creates a fiscal category with a canonical key"
      }
    },
    "taxes.rules.create": {
      "permission": "taxes.manage_tax",
      "transaction": true,
      "sql": [
        "commands/rule_create.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "taxes.rule_incoherent",
        "message": "That rule could not be created: a component must hang from a root rule of this business with the same country, region and tax category, and its validity range cannot run backwards."
      },
      "schema": "schemas/rule_create.json",
      "emit": [
        "taxes.rule.created"
      ],
      "ai": {
        "description": "Creates a tax rule (the % for a country+region+category) with its fiscal qualification (operation_class / regime_key / exempt_reason). Pass parent_id to add a multi-tax component (e.g. surcharge) to a root rule."
      }
    },
    "taxes.rules.bulk_create": {
      "permission": "taxes.manage_tax",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create_rules"
      },
      "schema": "schemas/rules_bulk_create.json",
      "ai": {
        "description": "Creates multiple tax rules at once (e.g. 'create the 2026 Spain VAT rates'). Invalid rows are skipped without aborting the batch. Components (parent_id) must be created individually."
      }
    },
    "taxes.rules.deactivate": {
      "permission": "taxes.manage_tax",
      "transaction": true,
      "sql": [
        "commands/rule_deactivate.sql"
      ],
      "schema": "schemas/rule_deactivate.json",
      "emit": [
        "taxes.rule.deactivated"
      ],
      "ai": {
        "description": "Deactivates a tax rule so it no longer applies to new transactions (issued invoices keep their snapshot)"
      }
    },
    "taxes.aliases.create": {
      "permission": "taxes.manage_tax",
      "transaction": true,
      "sql": [
        "commands/alias_create.sql"
      ],
      "schema": "schemas/alias_create.json",
      "emit": [
        "taxes.alias.created"
      ],
      "ai": {
        "description": "Persists a category alias (external text → canonical key) learned during CSV import"
      }
    },
    "taxes._insert_category": {
      "permission": "taxes.manage_tax",
      "sql": [
        "commands/_insert_category.sql"
      ]
    },
    "taxes._insert_rule": {
      "permission": "taxes.manage_tax",
      "sql": [
        "commands/_insert_rule.sql"
      ]
    },
    "taxes.calculate": {
      "permission": "taxes.calculate_tax",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "calculate_tax"
      },
      "reads": [
        "taxes.rules.list"
      ],
      "ai": {
        "description": "Resolves and calculates the applicable tax for an amount by fiscal category (country/region from the hub's fiscal identity), returning the rate AND the fiscal qualification of the operation"
      }
    }
  },
  "events": {
    "listen": {},
    "emits": [
      "taxes.alias.created",
      "taxes.category.created",
      "taxes.rule.created",
      "taxes.rule.deactivated",
      "taxes.rules.bulk_create.report"
    ]
  },
  "ui": {
    "entry": "dist/taxes.esm.js"
  },
  "setup": {
    "query": "taxes.rules.status",
    "configured_when": [
      {
        "field": "matching_rules",
        "truthy": true
      }
    ],
    "title": "Your taxes",
    "description": "Set the VAT rates for the country you sell in, so the till can price a sale.",
    "icon": "receipt-outline",
    "route": "/m/taxes/rules",
    "permission": "taxes.manage_tax",
    "countries": [],
    "order": 20,
    "required": true
  }
}
