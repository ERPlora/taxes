{
  "id": "taxes",
  "name": "Taxes",
  "version": "1.0.4",
  "agent": {
    "description": "Manages tax categories, tax rates, and tax rules: list/create rates and categories, filter by country, define application rules, and calculate tax amounts for sale lines.",
    "keywords": [
      "tax",
      "vat",
      "rate",
      "category",
      "fiscal",
      "calculation",
      "rule"
    ]
  },
  "depends_on": [],
  "permissions": [
    "taxes.view_tax",
    "taxes.manage_tax",
    "taxes.calculate_tax"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "manager": [
      "taxes.view_tax",
      "taxes.manage_tax",
      "taxes.calculate_tax"
    ],
    "employee": [
      "taxes.view_tax",
      "taxes.calculate_tax"
    ]
  },
  "navigation": [
    {
      "id": "rates",
      "label": "Tax Rates",
      "icon": "receipt-outline",
      "component": "erp-taxes-rates"
    },
    {
      "id": "categories",
      "label": "Categories",
      "icon": "pricetags",
      "component": "erp-taxes-categories"
    },
    {
      "id": "rules",
      "label": "Rules",
      "icon": "funnel",
      "component": "erp-taxes-rules"
    }
  ],
  "migrations": {
    "sqlite": [
      "migrations/sqlite/001_init.sql"
    ],
    "postgres": [
      "migrations/postgres/001_init.sql"
    ]
  },
  "queries": {
    "taxes.categories.list": {
      "permission": "taxes.view_tax",
      "sql": "queries/categories_list.sql",
      "list": {
        "search": [
          "code",
          "name",
          "description"
        ],
        "sort": [
          "id",
          "code",
          "name",
          "description",
          "is_active"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "code": {
            "op": "eq"
          },
          "name": {
            "op": "eq"
          },
          "description": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the available tax categories"
      },
      "expose_api": true
    },
    "taxes.rates.list": {
      "permission": "taxes.view_tax",
      "sql": "queries/rates_list.sql",
      "list": {
        "search": [
          "code",
          "name",
          "country_code",
          "region_code"
        ],
        "sort": [
          "id",
          "code",
          "name",
          "category_id",
          "country_code",
          "region_code",
          "rate_pct",
          "tax_type",
          "applies_from",
          "applies_until",
          "is_active"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "code": {
            "op": "eq"
          },
          "name": {
            "op": "eq"
          },
          "category_id": {
            "op": "eq"
          },
          "country_code": {
            "op": "eq"
          },
          "region_code": {
            "op": "eq"
          },
          "rate_pct": {
            "op": "range"
          },
          "tax_type": {
            "op": "range"
          },
          "applies_from": {
            "op": "eq"
          },
          "applies_until": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists all configured tax rates"
      },
      "expose_api": true
    },
    "taxes.rates.get": {
      "permission": "taxes.view_tax",
      "sql": "queries/rate_get.sql",
      "ai": {
        "description": "Gets the details of a tax rate by its identifier"
      },
      "expose_api": true
    },
    "taxes.rules.list": {
      "permission": "taxes.view_tax",
      "sql": "queries/rules_list.sql",
      "list": {
        "search": [
          "code",
          "name"
        ],
        "sort": [
          "id",
          "code",
          "name",
          "conditions",
          "tax_rate_id",
          "priority",
          "is_active"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "code": {
            "op": "eq"
          },
          "name": {
            "op": "eq"
          },
          "conditions": {
            "op": "eq"
          },
          "tax_rate_id": {
            "op": "range"
          },
          "priority": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists tax application rules"
      },
      "expose_api": true
    },
    "taxes.rates.by_country": {
      "permission": "taxes.view_tax",
      "sql": "queries/rates_by_country.sql",
      "ai": {
        "description": "Lists tax rates filtered by country"
      },
      "expose_api": true
    }
  },
  "commands": {
    "taxes.categories.create": {
      "permission": "taxes.manage_tax",
      "transaction": true,
      "sql": [
        "commands/category_create.sql"
      ],
      "schema": "schemas/category_create.json",
      "emit": [
        "taxes.category.created"
      ],
      "ai": {
        "description": "Creates a new tax category"
      }
    },
    "taxes.rates.create": {
      "permission": "taxes.manage_tax",
      "transaction": true,
      "sql": [
        "commands/rate_create.sql"
      ],
      "schema": "schemas/rate_create.json",
      "emit": [
        "taxes.rate.created"
      ],
      "ai": {
        "description": "Creates a new tax rate with its percentage; the category is optional"
      }
    },
    "taxes.rates.bulk_create": {
      "permission": "taxes.manage_tax",
      "schema": "schemas/rates_bulk_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bulk_create_rates"
      },
      "ai": {
        "description": "Creates multiple tax rates in a single call (e.g. all the VAT rates of a country at once, such as 'create the 2026 VAT rates for Spain'). The category is optional. Invalid rows are skipped without aborting the batch."
      }
    },
    "taxes.rates.deactivate": {
      "permission": "taxes.manage_tax",
      "transaction": true,
      "sql": [
        "commands/rate_deactivate.sql"
      ],
      "schema": "schemas/rate_deactivate.json",
      "emit": [
        "taxes.rate.deactivated"
      ],
      "ai": {
        "description": "Deactivates a tax rate so it no longer applies to new transactions"
      }
    },
    "taxes.rules.create": {
      "permission": "taxes.manage_tax",
      "transaction": true,
      "sql": [
        "commands/rule_create.sql"
      ],
      "schema": "schemas/rule_create.json",
      "emit": [
        "taxes.rule.created"
      ],
      "ai": {
        "description": "Creates an automatic tax application rule based on product or customer criteria"
      }
    },
    "taxes._insert_rate": {
      "permission": "taxes.manage_tax",
      "sql": [
        "commands/_insert_rate.sql"
      ]
    },
    "taxes.calculate": {
      "permission": "taxes.calculate_tax",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "calculate_tax"
      },
      "reads": ["taxes.rates.list", "taxes.rules.list"],
      "ai": {
        "description": "Calculates the applicable tax amount for a set of sale lines"
      }
    }
  },
  "ui": {
    "entry": "dist/taxes.esm.js"
  }
}
