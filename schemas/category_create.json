{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "taxes.categories.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["key", "name"],
  "properties": {
    "key": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9_.]*$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 255 },
    "description": { "type": "string", "default": "", "maxLength": 1000 },
    "is_system": { "type": "integer", "enum": [0, 1], "default": 0 }
  }
}
