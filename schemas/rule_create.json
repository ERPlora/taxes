{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "taxes.rules.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["country_code", "tax_category_key", "rate_pct"],
  "properties": {
    "country_code": { "type": "string", "minLength": 2, "maxLength": 2 },
    "region_code": { "type": ["string", "null"], "default": null, "maxLength": 10 },
    "tax_category_key": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9_.]*$" },
    "rate_pct": { "type": "number", "minimum": 0 },
    "tax_type": {
      "type": "string",
      "enum": ["vat", "surcharge", "sales_tax", "withholding", "excise", "import_duty"],
      "default": "vat"
    },
    "parent_id": { "type": ["string", "null"], "default": null },
    "component_label": { "type": ["string", "null"], "default": null, "maxLength": 120 },
    "valid_from": { "type": ["string", "null"], "format": "date", "default": null },
    "valid_to": { "type": ["string", "null"], "format": "date", "default": null }
  }
}
