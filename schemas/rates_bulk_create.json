{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "taxes.rates.bulk_create",
  "description": "Input del handler WASM bulk_create_rates: alta batch de tipos impositivos (cap 100) en una sola llamada (ADR-0066). Lo usa el asistente ('créame el IVA de España 2026') y el import CSV de productos. category_id es opcional; las líneas inválidas se saltan sin abortar el lote (se reportan en el evento taxes.rates.bulk_create.report).",
  "type": "object",
  "additionalProperties": false,
  "required": ["rates"],
  "properties": {
    "rates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "country_code", "rate_pct"],
        "properties": {
          "code": { "type": "string", "minLength": 1, "maxLength": 50 },
          "name": { "type": "string", "default": "", "maxLength": 255 },
          "category_id": { "type": ["string", "null"], "default": null },
          "country_code": { "type": "string", "minLength": 2, "maxLength": 2 },
          "region_code": { "type": "string", "default": "", "maxLength": 10 },
          "rate_pct": { "type": "number", "minimum": 0 },
          "tax_type": {
            "type": "string",
            "enum": ["vat", "sales_tax", "withholding", "excise", "import_duty"],
            "default": "vat"
          },
          "applies_from": { "type": ["string", "null"], "format": "date", "default": null },
          "applies_until": { "type": ["string", "null"], "format": "date", "default": null }
        }
      }
    }
  }
}
